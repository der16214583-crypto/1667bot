{
  "name": "hoowers-logs-bot",
  "version": "1.0.0",
  "description": "Full stack Discord bot for logging server events",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "deploy": "ts-node-dev --transpile-only ./deploy-commands.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "logging",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sqlite3": "^5.1.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/sqlite3": "^3.1.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
